{
    "name": "invyte/inventory-management",
    "description": "Inventory Management System for Magento 2",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/lumen-framework": "^10.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}
